# Environment variables for MedTrack (Vite)
# NOTE: All frontend variables in Vite must be prefixed with VITE_ to be accessible in the browser.
# Access them in code using: import.meta.env.VITE_VARIABLE_NAME

# Example API or backend endpoints (optional):
# VITE_API_BASE_URL=https://api.example.com
# VITE_APP_TITLE=MEDTRACK
